<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ControllerSync.App.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window">
      <Setter Property="FontFamily" Value="Inter, Segoe UI, sans-serif"/>
      <Setter Property="Foreground" Value="#F4F1EA"/>
    </Style>
    <Style Selector="TextBlock.h1">
      <Setter Property="FontSize" Value="28"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="LetterSpacing" Value="1.5"/>
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#A7A094"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="Foreground" Value="#C8BBA4"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="LetterSpacing" Value="1.2"/>
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="#171910"/>
      <Setter Property="BorderBrush" Value="#343628"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="Padding" Value="18"/>
    </Style>
    <Style Selector="Border.tally">
      <Setter Property="Background" Value="#3A2218"/>
      <Setter Property="BorderBrush" Value="#8A4B2F"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="18,12"/>
      <Setter Property="MinWidth" Value="180"/>
    </Style>
    <Style Selector="Border.tally.up">
      <Setter Property="Background" Value="#163024"/>
      <Setter Property="BorderBrush" Value="#2F8A5B"/>
    </Style>
    <Style Selector="Border.banner">
      <Setter Property="Background" Value="#10120C"/>
      <Setter Property="BorderBrush" Value="#3A3F2E"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="18"/>
      <Setter Property="Padding" Value="22,16"/>
    </Style>
    <Style Selector="Button.role">
      <Setter Property="Background" Value="#1C1F16"/>
      <Setter Property="Foreground" Value="#F4F1EA"/>
      <Setter Property="BorderBrush" Value="#343628"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="MinHeight" Value="72"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Padding" Value="14,10"/>
    </Style>
    <Style Selector="Button.role:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#262A1C"/>
    </Style>
    <Style Selector="Button.role.selected">
      <Setter Property="Background" Value="#3A2E14"/>
      <Setter Property="BorderBrush" Value="#E0A23A"/>
      <Setter Property="BorderThickness" Value="2"/>
    </Style>
    <Style Selector="Button.go">
      <Setter Property="Background" Value="#E0A23A"/>
      <Setter Property="Foreground" Value="#1A1408"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="MinHeight" Value="48"/>
      <Setter Property="MinWidth" Value="140"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Padding" Value="18,8"/>
    </Style>
    <Style Selector="Button.stop">
      <Setter Property="Background" Value="#2A2118"/>
      <Setter Property="Foreground" Value="#F4F1EA"/>
      <Setter Property="BorderBrush" Value="#8A4B2F"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="MinHeight" Value="48"/>
      <Setter Property="Padding" Value="18,8"/>
    </Style>
    <Style Selector="Button.quiet">
      <Setter Property="Background" Value="#1C1F16"/>
      <Setter Property="Foreground" Value="#F4F1EA"/>
      <Setter Property="BorderBrush" Value="#343628"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="MinHeight" Value="48"/>
      <Setter Property="Padding" Value="16,8"/>
    </Style>
    <Style Selector="TextBox">
      <Setter Property="MinHeight" Value="42"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="10,6"/>
    </Style>
    <Style Selector="TextBox.mono">
      <Setter Property="FontFamily" Value="Consolas, DejaVu Sans Mono, monospace"/>
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Margin" Value="0,4"/>
    </Style>
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="18,10"/>
    </Style>
    <Style Selector="ProgressBar">
      <Setter Property="Foreground" Value="#E0A23A"/>
      <Setter Property="MinHeight" Value="8"/>
    </Style>
  </Application.Styles>
</Application>
