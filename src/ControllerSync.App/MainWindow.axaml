<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ControllerSync.App.ViewModels"
        x:Class="ControllerSync.App.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="ControllerSync"
        Width="1080"
        Height="920"
        MinWidth="920"
        MinHeight="740"
        Background="#12140E"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="28" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="16">
    <Grid ColumnDefinitions="*,Auto">
      <StackPanel Spacing="4">
        <TextBlock Classes="h1" Text="CONTROLLERSYNC"/>
        <TextBlock Classes="muted" Text="PowerPoint backup or Resolume clips. One job at a time, so they do not run together."/>
        <TextBlock Classes="muted" Text="{Binding MachineName, StringFormat='This laptop: {0}'}"/>
      </StackPanel>
      <Border Grid.Column="1" Classes="tally" Classes.live="{Binding IsRunning}" Classes.up="{Binding IsLinked}" VerticalAlignment="Top" Margin="20,0,0,0">
        <StackPanel Spacing="2">
          <TextBlock Classes="label" Text="LINK"/>
          <TextBlock Text="{Binding TallyText}" FontSize="22" FontWeight="Bold"/>
          <TextBlock Classes="muted" Text="{Binding LinkDetail}" FontSize="12" MaxWidth="220"/>
        </StackPanel>
      </Border>
    </Grid>

    <StackPanel Grid.Row="1" Spacing="10">
      <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
        <Button Classes="role" Classes.selected="{Binding IsPowerPoint}" Command="{Binding SetJobCommand}" CommandParameter="PowerPoint">
          <StackPanel Spacing="2">
            <TextBlock Text="PowerPoint" FontWeight="Bold" FontSize="16"/>
            <TextBlock Text="Slide sync only" FontSize="12" Foreground="#A7A094"/>
          </StackPanel>
        </Button>
        <Button Grid.Column="1" Classes="role" Classes.selected="{Binding IsResolume}" Command="{Binding SetJobCommand}" CommandParameter="Resolume">
          <StackPanel Spacing="2">
            <TextBlock Text="Resolume" FontWeight="Bold" FontSize="16"/>
            <TextBlock Text="Clips only, no slide sync" FontSize="12" Foreground="#A7A094"/>
          </StackPanel>
        </Button>
      </Grid>
      <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10" IsVisible="{Binding IsPowerPoint}">
        <Button Classes="role" Classes.selected="{Binding IsPrimary}" Command="{Binding SetRoleCommand}" CommandParameter="Primary">
          <StackPanel Spacing="2">
            <TextBlock Text="Primary" FontWeight="Bold" FontSize="16"/>
            <TextBlock Text="Show laptop" FontSize="12" Foreground="#A7A094"/>
          </StackPanel>
        </Button>
        <Button Grid.Column="1" Classes="role" Classes.selected="{Binding IsBackup}" Command="{Binding SetRoleCommand}" CommandParameter="Backup">
          <StackPanel Spacing="2">
            <TextBlock Text="Backup" FontWeight="Bold" FontSize="16"/>
            <TextBlock Text="Follows the show" FontSize="12" Foreground="#A7A094"/>
          </StackPanel>
        </Button>
        <Button Grid.Column="2" Classes="role" Classes.selected="{Binding IsTwoWay}" Command="{Binding SetRoleCommand}" CommandParameter="TwoWay">
          <StackPanel Spacing="2">
            <TextBlock Text="Two-way" FontWeight="Bold" FontSize="16"/>
            <TextBlock Text="Either laptop leads" FontSize="12" Foreground="#A7A094"/>
          </StackPanel>
        </Button>
      </Grid>
      <TextBlock Classes="muted" Text="{Binding RoleHelp}"/>
    </StackPanel>

    <ScrollViewer Grid.Row="2">
      <StackPanel Spacing="14">
        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
          <Border Classes="card">
            <StackPanel Spacing="8">
              <TextBlock Classes="label" Text="INCOMING  ·  THIS LAPTOP"/>
              <TextBlock Classes="muted" Text="The address this laptop listens on. 0.0.0.0 means every network port on this machine."/>
              <Grid ColumnDefinitions="*,110" ColumnSpacing="8">
                <TextBox Classes="mono" Watermark="0.0.0.0" Text="{Binding BindAddress}" IsEnabled="{Binding !IsRunning}"/>
                <TextBox Grid.Column="1" Classes="mono" Watermark="24710" Text="{Binding ListenPortText}" IsEnabled="{Binding !IsRunning}"/>
              </Grid>
              <TextBlock Classes="label" Text="THIS LAPTOP'S IP" Margin="0,6,0,0"/>
              <TextBlock Text="{Binding ThisLaptopIp}" FontFamily="Consolas, DejaVu Sans Mono, monospace" FontSize="20" FontWeight="Bold"/>
              <TextBlock Classes="muted" Text="{Binding ThisLaptopHint}"/>
              <Button Classes="quiet" Content="Copy IP" Command="{Binding CopyIpCommand}" HorizontalAlignment="Left"/>
            </StackPanel>
          </Border>
          <Border Grid.Column="1" Classes="card">
            <StackPanel Spacing="8">
              <TextBlock Classes="label" Text="OUTGOING  ·  OTHER LAPTOP"/>
              <TextBlock Classes="muted" Text="Where cues are sent. On the backup laptop this can stay empty."/>
              <Grid ColumnDefinitions="*,110" ColumnSpacing="8">
                <TextBox Classes="mono" Watermark="192.168.1.20" Text="{Binding RemoteAddress}" IsEnabled="{Binding !IsRunning}"/>
                <TextBox Grid.Column="1" Classes="mono" Watermark="24710" Text="{Binding RemotePortText}" IsEnabled="{Binding !IsRunning}"/>
              </Grid>
              <TextBlock Classes="label" Text="CHANNEL" Margin="0,6,0,0"/>
              <TextBox Classes="mono" Watermark="show" Text="{Binding Channel}" IsEnabled="{Binding !IsRunning}"/>
              <TextBlock Classes="muted" Text="Both laptops must use the same channel, or they will ignore each other."/>
            </StackPanel>
          </Border>
        </Grid>

        <StackPanel Spacing="8">
          <WrapPanel>
            <Button Classes="go" Content="Start link" Command="{Binding StartCommand}" Margin="0,0,8,8"/>
            <Button Classes="stop" Content="Stop" Command="{Binding StopCommand}" Margin="0,0,8,8"/>
            <Button Classes="quiet" Content="Open firewall ports" Command="{Binding FirewallCommand}" Margin="0,0,8,8" IsVisible="{Binding IsWindows}"/>
          </WrapPanel>
          <TextBlock Foreground="#E07A5F" Text="{Binding FormError}" TextWrapping="Wrap" IsVisible="{Binding HasError}"/>
        </StackPanel>

        <TabControl>
          <TabItem Header="Show">
            <StackPanel Spacing="14" Margin="0,12,0,0">
              <Border Classes="card">
                <StackPanel Spacing="4">
                  <TextBlock Classes="label" Text="WHAT TO SYNC"/>
                  <TextBlock Classes="muted" Text="Presentation keys are arrows, space, Page Up and Down, Enter, Home, End, F5, Escape, B, and W. Other keys stay on this laptop unless you opt in."/>
                <TextBlock Foreground="#E0A23A" Text="PowerPoint sync is off in Resolume mode. Arrow keys, mouse, and slides stay on this laptop. Stop the link and choose PowerPoint to use them again." TextWrapping="Wrap" IsVisible="{Binding IsResolume}" Margin="0,4,0,4"/>
                <WrapPanel>
                  <CheckBox Content="Presentation keys" IsChecked="{Binding SendKeyboard}" IsEnabled="{Binding CanEditShow}" Margin="0,4,18,4"/>
                  <CheckBox Content="Mouse clicks" IsChecked="{Binding SendMouseClicks}" IsEnabled="{Binding CanEditShow}" Margin="0,4,18,4"/>
                  <CheckBox Content="Mouse movement" IsChecked="{Binding SendMouseMove}" IsEnabled="{Binding CanEditShow}" Margin="0,4,18,4"/>
                  <CheckBox Content="Every key" IsChecked="{Binding SendAllKeys}" IsEnabled="{Binding CanEditShow}" Margin="0,4,18,4"/>
                  <CheckBox Content="Publish slide position" IsChecked="{Binding PublishSlides}" IsEnabled="{Binding CanEditShow}" Margin="0,4,18,4"/>
                  <CheckBox Content="Follow the other laptop" IsChecked="{Binding FollowSlides}" IsEnabled="{Binding CanEditShow}" Margin="0,4,18,4"/>
                </WrapPanel>
                  <TextBlock Foreground="#E07A5F" Text="Every key includes passwords. Leave that off on a show laptop." IsVisible="{Binding SendAllKeys}"/>
                  <TextBlock Classes="muted" Text="Mouse movement is off by default. Slide changes do not need it, and it fills the link." IsVisible="{Binding SendMouseMove}"/>
                </StackPanel>
              </Border>
              <WrapPanel>
                <Button Classes="quiet" Content="Send previous" Command="{Binding PreviousCommand}" Margin="0,0,8,8"/>
                <Button Classes="quiet" Content="Send next" Command="{Binding NextCommand}" Margin="0,0,8,8"/>
                <Button Classes="quiet" Content="Send black" Command="{Binding BlackCommand}" Margin="0,0,8,8"/>
              </WrapPanel>
              <Border Classes="banner">
                <StackPanel Spacing="2">
                  <TextBlock Classes="label" Text="LAST CUE FROM THE OTHER LAPTOP"/>
                  <TextBlock Text="{Binding Banner}" FontSize="54" FontWeight="Bold" LetterSpacing="1"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </TabItem>
          <TabItem Header="Resolume">
            <StackPanel Spacing="14" Margin="0,12,0,0">
              <Border Classes="card">
                <StackPanel Spacing="8">
                  <TextBlock Classes="label" Text="CLIP FOR EVERY LAPTOP"/>
                  <TextBlock Foreground="#E0A23A" Text="Clip sending is off while PowerPoint sync is on. Stop the link and choose Resolume. Every laptop that should take the clip must be on Resolume too." TextWrapping="Wrap" IsVisible="{Binding IsPowerPoint}"/>
                  <TextBlock Classes="muted" Text="Start the link on this laptop and on every backup first. Choose one file or several. One send copies them onto each machine and loads them in that laptop's Resolume. The first file uses the layer and clip below. Each next file uses the next clip. Sending a file that is already in the media folder saves a new copy and loads that copy, so Resolume opens it again. PowerPoint keys and slides are not used. In Resolume, open Preferences, Web Server, and turn it on. The usual port is 8080."/>
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox Classes="mono" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" Watermark="C:\Shows\intro.mp4" Text="{Binding ContentPath}"/>
                    <Button Grid.Column="1" Classes="quiet" Content="Browse" Command="{Binding PickContentCommand}" MinWidth="110" VerticalAlignment="Top"/>
                  </Grid>
                  <TextBlock Classes="muted" Text="Cancel removes that video. If it was already sent, Cancel clears it in Resolume and deletes the saved copy on each laptop."/>
                  <ItemsControl ItemsSource="{Binding ChosenClips}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:ContentClip">
                        <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                          <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding FileName}" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Classes="muted" Text="{Binding Status}" FontSize="12"/>
                          </StackPanel>
                          <Button Grid.Column="1" Classes="quiet" Content="Cancel" Command="{Binding CancelCommand}" MinWidth="90" Margin="8,0,0,0"/>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Grid ColumnDefinitions="120,120,160" ColumnSpacing="8">
                    <StackPanel Spacing="4">
                      <TextBlock Classes="label" Text="LAYER"/>
                      <TextBox Classes="mono" Watermark="1" Text="{Binding LayerText}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4">
                      <TextBlock Classes="label" Text="CLIP"/>
                      <TextBox Classes="mono" Watermark="1" Text="{Binding ClipText}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4">
                      <TextBlock Classes="label" Text="RESOLUME PORT"/>
                      <TextBox Classes="mono" Watermark="8080" Text="{Binding ResolumePortText}"/>
                    </StackPanel>
                  </Grid>
                  <TextBlock Classes="label" Text="SIZE AND POSITION" Margin="0,6,0,0"/>
                  <TextBlock Classes="muted" Text="Pixels, the same numbers Resolume shows for the clip. Leave a box empty to keep the value already there. Width and height stretch the clip to that size. X and Y are Position X and Position Y. They are applied after the file opens and before playback starts."/>
                  <Grid ColumnDefinitions="120,120,120,120" ColumnSpacing="8">
                    <StackPanel Spacing="4">
                      <TextBlock Classes="label" Text="WIDTH"/>
                      <TextBox Classes="mono" Watermark="1920" Text="{Binding ContentWidth}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4">
                      <TextBlock Classes="label" Text="HEIGHT"/>
                      <TextBox Classes="mono" Watermark="1080" Text="{Binding ContentHeight}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4">
                      <TextBlock Classes="label" Text="X"/>
                      <TextBox Classes="mono" Watermark="0" Text="{Binding ContentX}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Spacing="4">
                      <TextBlock Classes="label" Text="Y"/>
                      <TextBox Classes="mono" Watermark="0" Text="{Binding ContentY}"/>
                    </StackPanel>
                  </Grid>
                  <WrapPanel>
                    <CheckBox Content="Start playback after load" IsChecked="{Binding PlayAfterLoad}" Margin="0,4,18,4"/>
                    <CheckBox Content="Also load on this laptop" IsChecked="{Binding LoadOnThisLaptop}" Margin="0,4,18,4"/>
                  </WrapPanel>
                </StackPanel>
              </Border>
              <Border Classes="card">
                <StackPanel Spacing="8">
                  <TextBlock Classes="label" Text="MORE BACKUP LAPTOPS"/>
                  <TextBlock Classes="muted" Text="The outgoing IP above is included automatically. Add every other backup, one per line. If that laptop listens on a different incoming port, write ip:port. The clip is sent to the next port, so 24710 receives content on 24711."/>
                  <TextBox Classes="mono" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="88" Watermark="192.168.1.21" Text="{Binding ExtraLaptops}"/>
                </StackPanel>
              </Border>
              <StackPanel Spacing="8">
                <Button Classes="go" Content="Send to every laptop" Command="{Binding SendContentCommand}" HorizontalAlignment="Left"/>
                <ProgressBar Minimum="0" Maximum="1" Value="{Binding ContentProgress}" IsVisible="{Binding IsSending}"/>
                <TextBlock Text="{Binding ContentStatus}" TextWrapping="Wrap" IsVisible="{Binding HasContentStatus}"/>
              </StackPanel>
            </StackPanel>
          </TabItem>
        </TabControl>

        <Border Classes="card" Padding="0">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Classes="label" Text="ACTIVITY" Margin="18,14,18,8"/>
            <ListBox x:Name="LogList" ItemsSource="{Binding LogLines}" Background="#10120C" BorderThickness="0" MinHeight="160" MaxHeight="220"
                     FontFamily="Consolas, DejaVu Sans Mono, monospace" FontSize="13" Foreground="#D9D3C5"/>
          </DockPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <TextBlock Grid.Row="3" Classes="muted" Text="Open the same PowerPoint file on both laptops before the show. If the primary laptop dies, the backup is already on that slide. Resolume clips are saved on each laptop and opened there. Nothing is sent to the internet."/>
  </Grid>
</Window>
